# Copie para pipeline/.env e preencha só o que for usar.
# O arquivo .env não entra no git.

# --- Claude Code CLI (provedor principal) ---
# No computador onde o robô roda: `claude` já logado na assinatura (claude /login).
# O alias `haiku` escolhe o Haiku atual da assinatura. A classificação ao vivo
# foi pensada para Haiku 5.5; se `claude` listar um id completo, use-o aqui.
CLAUDE_BIN=claude
CLAUDE_MODEL=haiku
# Orçamento de latência de uma chamada, em segundos. Estourou: failover.
CLAUDE_TIMEOUT_S=12
# Sessão stream-json reaproveitada. Depois de N falas, abre sessão nova
# para o contexto não crescer o debate inteiro.
CLAUDE_SESSION_CHUNKS=8

# --- OpenRouter (fallback, modelos :free) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT_S=20

# Ordem. anthropic e gemini só entram se a chave correspondente existir.
LLM_PROVIDERS=claude_cli,openrouter
LLM_RETRIES=1
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_S=60

# --- Provedores opcionais (API direta) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Busca ---
# Google Fact Check Tools API (gratuita, com chave)
FACTCHECK_API_KEY=
# SearXNG self-hosted, ex. http://127.0.0.1:8080
SEARXNG_URL=
# Opcional
BRAVE_API_KEY=

# --- Áudio ---
CHUNK_SECONDS=10
CHUNK_OVERLAP_SECONDS=2
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Saída ---
PLACAR_HOST=127.0.0.1
PLACAR_PORT=8787
# Supabase Storage (service role). Vazio = não envia.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=placar
# Cloudflare R2 (S3). Vazio = não envia.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=placar
